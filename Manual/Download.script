Stat:=
{
	NrFilesDownloaded:0,
	NrErrors:0
};

Timeout:=10*60*60*1000;
Binary:=Utf8Encode("Hello").GetType();
ws:=Waher.Content.Xml.XML.WriterSettings(true,true);
LinkUri:=null;

DownloadFiles(PageUrl,DownloadFolder):=
(
	if !System.IO.Directory.Exists(DownloadFolder) then
		System.IO.Directory.CreateDirectory(DownloadFolder);

	preview(printline("Downloading: "+PageUrl));
	PageUrl:=Create(System.Uri,PageUrl);

	Page:=GET(PageUrl,{
		"Accept": "text/html,application/xhtml+xml",
		"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36 Edg/146.0.0.0",
		"Accept-Language": "en-US,en;q=0.5",
		"Cache-Control": "no-cache",
		"Sec-Ch-Ua": "\"Chromium\";v=\"146\", \"Not-A.Brand\";v=\"24\", \"Microsoft Edge\";v=\"146\"",
		"Sec-Ch-Ua-Mobile": "?0",
		"Sec-Ch-Ua-Platform": "\"Windows\"",
		"Sec-Fetch-Dest": "document",
		"Sec-Fetch-Mode": "navigate",
		"Sec-Fetch-Site": "none",
		"Sec-Fetch-User": "?1",
		"Upgrade-Insecure-Requests": "1"
	});

	preview(printline("Downloaded."));

	sb:=Create(System.Text.StringBuilder);
	w:=System.Xml.XmlWriter.Create(sb,ws);
	Page.Export(w);
	w.Flush();
	x:=Xml(sb.ToString());
	hs:=Create(System.Collections.Generic.HashSet,System.String);
	foreach Node in x.SelectNodes("//A/@href") do hs.Add(Node.Value);
	Links:=[foreach Link in hs : Link];
	preview(printline(Str(c:=count(Links))+" unique links in document."));
	i:=0;
	
	foreach Link in Links do
	(
		if !empty(Link) && Link!="#" && System.Uri.TryCreate(PageUrl,Link,LinkUri) then
		(
			try
			(
				preview(printline("Downloading (" + ++i + "/" + c + "): "+Str(LinkUri)));

				Content:=Get(LinkUri,{
					"Accept": "*/*",
					"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36 Edg/146.0.0.0",
					"Accept-Language": "en-US,en;q=0.5",
					"Cache-Control": "no-cache",
					"Sec-Ch-Ua": "\"Chromium\";v=\"146\", \"Not-A.Brand\";v=\"24\", \"Microsoft Edge\";v=\"146\"",
					"Sec-Ch-Ua-Mobile": "?0",
					"Sec-Ch-Ua-Platform": "\"Windows\"",
					"Sec-Fetch-Dest": "document",
					"Sec-Fetch-Mode": "navigate",
					"Sec-Fetch-Site": "none",
					"Sec-Fetch-User": "?1",
					"Upgrade-Insecure-Requests": "1"
				});

				FileName:=UrlDecode(System.IO.Path.GetFileName(Link));
				FileName:=System.IO.Path.Combine(DownloadFolder,FileName);

				if Content is Binary then
				(
					SaveFile(Content,FileName);
					Stat.NrFilesDownloaded++;
				)
				else if Content is Waher.Content.Binary.CustomEncoding then
				(
					SaveFile(Content.Encoded,FileName);
					Stat.NrFilesDownloaded++;
				)
				else if Content is Waher.Content.Zip.ZipFile then
				(
					SaveFile(Content.Binary,FileName);
					Stat.NrFilesDownloaded++;
				)
				else if Content is Waher.IoTGateway.Encoding.BinaryPdfDocument then
				(
					SaveFile(Content.Document,FileName);
					Stat.NrFilesDownloaded++;
				)
				else
					preview(printline("Type: "+Str(Content.GetType())));
			)
			catch
			(
				printline("Error ("+Link+"): "+Exception.Message);
				Stat.NrErrors++;
			)
		)
	);
	preview(printline("Links processed."));
);

PrintStat():=
(
	printline("Nr Files Downloaded: "+Stat.NrFilesDownloaded);
	printline("Nr Errors: "+Stat.NrErrors);
);

ZeroStat():=
(
	Stat.NrFilesDownloaded:=0;
	Stat.NrErrors:=0;
);

